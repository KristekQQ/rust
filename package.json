{
  "dependencies": {
    "pngjs": "7.0.0",
    "puppeteer": "25.12.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:sdk": "node --test tests/sdk-unit.test.mjs",
    "test:harness": "node --test tests/harness-unit.test.mjs",
    "verify:fast": "npm run typecheck && npm run test:sdk && npm run test:harness",
    "test:browser": "node scripts/test-browser.mjs",
    "verify": "bash scripts/verify.sh all",
    "verify:push": "bash scripts/pre-push",
    "verify:native": "bash scripts/verify.sh native",
    "verify:browser": "bash scripts/verify.sh browser",
    "test:xr": "node --test tests/xr-simulator-unit.test.mjs",
    "verify:vr": "npm run test:xr && bash scripts/verify.sh browser --page webxr-contract,webxr,webxr-simulation,neon-arena-xr --backend webgl --capture"
  }
}
